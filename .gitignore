# Enlace local a skills/ (junction de Windows): se recrea en cada máquina
.claude/skills
.claude/settings.local.json
CLAUDE.local.md

# Obsidian: solo se comparte la config común (app.json, plugins activos y su data.json);
# workspace, tema, caché y el código de los plugins son de cada máquina.
.obsidian/*
!.obsidian/app.json
!.obsidian/community-plugins.json
!.obsidian/plugins/
.obsidian/plugins/*/*
!.obsidian/plugins/*/data.json
.trash/

# Roblox / Rojo
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
sourcemap.json

# Descargas de tools/check.py (definiciones de tipos de Roblox)
.cache/

# Python
__pycache__/
*.pyc

# Sistema
.DS_Store
Thumbs.db

# Salidas de generadores con IA: al repo solo pasa lo elegido, registrado en assets/index.json
meshy_output/

# Claves locales (nunca al repo): las claves van en variables de entorno
.env
*.env
